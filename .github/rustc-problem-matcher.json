{
  "problemMatcher": [
    {
      "owner": "elzevir-rustc",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^error(?:\\[([^\\]]+)\\])?: (.+)$",
          "code": 1,
          "message": 2
        }
      ]
    },
    {
      "owner": "elzevir-nextest",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^\\s*thread .+ panicked at (.+):(\\d+):(\\d+):$",
          "file": 1,
          "line": 2,
          "column": 3
        },
        {
          "regexp": "^\\s*(.+)$",
          "message": 1
        }
      ]
    }
  ]
}
