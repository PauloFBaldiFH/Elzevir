--

CREATE TABLE public.acervo (
    mfn integer NOT NULL,
    tipo text,
    idioma text,
    centro_cooperante text,
    n_chamada text,
    registro text,
    aut_pes text,
    aut_ent text,
    aut_ev text,
    titulo text,
    edicao text,
